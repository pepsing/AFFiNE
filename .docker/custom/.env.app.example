# 应用连接中间件的示例配置
# 复制为 .env.app 并按需修改

# ===== 数据库 =====
DB_HOST=host.docker.internal
DB_PORT=5432
DB_USERNAME=affine
DB_PASSWORD=affine
DB_DATABASE=affine

# ===== Redis =====
REDIS_SERVER_HOST=host.docker.internal
REDIS_SERVER_PORT=6379

# ===== Manticore =====
MANTICORE_HOST=host.docker.internal
MANTICORE_PORT=9308

# ===== 应用端口 =====
PORT=3010

# ===== 其它可选项 =====
AFFINE_INDEXER_ENABLED=false

