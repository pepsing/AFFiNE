# Middleware Configuration
# 中间件配置文件 - 用于独立部署中间件

# PostgreSQL Configuration
DB_PORT=5432
DB_USERNAME=affine
DB_PASSWORD=your_secure_password_here
DB_DATABASE=affine
DB_DATA_LOCATION=./data/postgres

# Redis Configuration
REDIS_PORT=6379
# 如果需要 Redis 密码保护，设置此项
REDIS_PASSWORD=
REDIS_DATA_LOCATION=./data/redis

# Mailpit Configuration (Optional)
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025
MAILPIT_DATA_LOCATION=./data/mailpit

# Manticoresearch Configuration (Optional)
MANTICORE_PORT=9308
MANTICORE_DATA_LOCATION=./data/manticore

# Security Notes:
# 1. Change DB_PASSWORD to a strong password
# 2. Consider setting REDIS_PASSWORD for production
# 3. Use firewall to restrict access to these ports
# 4. Consider using VPN or private network for middleware access
